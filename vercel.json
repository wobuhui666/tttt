{
    "version": 2,
    "redirects": [
        {
            "source": "/",
            "destination": "https://github.com/wobuhui666/tttt",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/:path*",
            "destination": "/api/tmdb.js"
        }
    ],
    "functions": {
        "api/tmdb.js": {
            "maxDuration": 10
        }
    }
}
